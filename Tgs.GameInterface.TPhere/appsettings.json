{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "PolicySettings": {
    "GlobalRetryCount": 3,
    "GlobalRetryWaitSec": 3,
    "DepositRetryCount": 3,
    "DepositRetryWaitSec": 3,
    "WithdrawRetryCount": 3,
    "WithdrawRetryWaitSec": 3
  }
}
